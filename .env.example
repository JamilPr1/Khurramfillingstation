# Public site URL (no trailing slash). Set this in Hostinger → Node.js app → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin (email is fixed to the station Gmail). Use a strong password, then change it in Admin → Settings.
ADMIN_EMAIL=khurramfillingstationpso@gmail.com
ADMIN_PASSWORD=

# Staff PIN for cashiers (4 to 6 digits). Admin can change this later in Settings.
STAFF_PIN=

# On Vercel this is set automatically when the Blob store is linked. Needed so
# customer cards stay in one shared list across logins.
# BLOB_READ_WRITE_TOKEN=
